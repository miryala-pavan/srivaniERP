DATABASE_URL="postgresql://<user>:<password>@localhost:4432/<dbname>"

JWT_SECRET=<replace-with-strong-random-secret>
JWT_EXPIRES_IN=12h
# Separate secret from JWT_SECRET on purpose — storefront customer tokens
# (phone-OTP verified) must never be valid against ERP staff routes. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STOREFRONT_JWT_SECRET=<replace-with-a-different-strong-random-secret>
STOREFRONT_JWT_EXPIRES_IN=7d

# Encrypts credential VALUES (WhatsApp access tokens, Facebook/Instagram page
# tokens, AI provider API keys) at rest in the database. Any string works —
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, credentials are stored/read as plain text (with a warning logged)
# — existing plain-text credentials keep working either way; this only
# controls whether NEW saves get encrypted. See backend/src/common/helpers/credential-encryption.util.ts.
CREDENTIALS_ENCRYPTION_KEY=<replace-with-a-strong-random-secret>
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:4000

# Optional Redis URL for shop-layer caching (nav-tree, categories, departments, single products).
# If unset or Redis is unavailable the shop falls back to direct DB queries silently.
# Example (local):  REDIS_URL=redis://127.0.0.1:6379
# Example (cloud):  REDIS_URL=rediss://:<password>@<host>:6380
# REDIS_URL=redis://127.0.0.1:6379

# Razorpay credentials (required for online payment; COD works without these).
# Get your keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) in development, live keys (rzp_live_...) in production.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Absolute path to the directory where product images are stored.
# This directory is served as static assets at /uploads/products/<filename>.
# IMPORTANT: Include this directory in your backup routine alongside pg_dump.
# Place noimage.svg (or noimage.png) here as the placeholder for products without images.
# Example (Windows): PRODUCT_IMAGES_DIR=J:\SVN\SVN_26\storage\product-images
# Example (Linux):   PRODUCT_IMAGES_DIR=/var/srivani/storage/product-images
PRODUCT_IMAGES_DIR=J:\SVN\SVN_26\storage\product-images

# Public base URL this API is reachable at — used to build absolute
# image_link URLs for the Meta (Facebook/Instagram) Commerce Catalog data
# feed. Must be a real, HTTPS, publicly resolvable domain in production —
# Meta's crawler cannot reach localhost or a private IP.
# Example (prod): API_PUBLIC_URL=https://api.srivani.com
API_PUBLIC_URL=http://localhost:4001

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Free: 1,000 conversations/month. No monthly fee.
# Orders work without these — WhatsApp is a silent no-op if unset.
#
# SETUP (one-time, ~30 minutes):
#   1. Go to https://developers.facebook.com → My Apps → Create App
#   2. App type: Business  →  Add product: WhatsApp
#   3. WhatsApp → API Setup:
#        - Copy "Temporary access token"  → WA_ACCESS_TOKEN (valid 24h for testing)
#        - Copy "Phone number ID"         → WA_PHONE_NUMBER_ID
#        - Add your mobile as "Test recipient"
#   4. For production: create a System User token in Meta Business Manager
#        (Business Settings → System Users → Add → Generate token → select app → whatsapp_business_messaging)
#
# TEST (verify credentials before creating templates):
#   POST /api/notifications/whatsapp/test   { "phone": "9XXXXXXXXX" }
#   This sends the pre-approved "hello_world" template — no template setup needed.
#
# TEMPLATES (create these in Meta Business Manager → WhatsApp → Message Templates):
#
#   1. Name: svn_order_placed  | Category: TRANSACTIONAL | Language: English
#      Body:
#        Hello {{1}}, your order *{{2}}* has been placed at Srivani Stores! 🎉
#        Total: ₹{{3}} | {{4}}
#        We will keep you updated. Thank you for shopping with us! 🙏
#
#   2. Name: svn_payment_done  | Category: TRANSACTIONAL | Language: English
#      Body:
#        Hello {{1}}, payment of ₹{{2}} received! ✅
#        Order *{{3}}* is confirmed. We will start preparing it now.
#        - Srivani Stores
#
#   3. Name: svn_order_update  | Category: TRANSACTIONAL | Language: English
#      Body:
#        Hello {{1}},
#        Your order *{{2}}* update:
#        {{3}}
#        - Team Srivani Stores
#
#   4. Name: test_order  | Category: TRANSACTIONAL | Language: English  (store alert)
#      Body:
#        New order {{1}} from {{2}} ({{3}}).
#        Items: {{4}} | Total: ₹{{5}} | {{6}} | {{7}}
#
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_STORE_NOTIFY_NUMBER=91XXXXXXXXXX

# ── Facebook & Instagram (Meta Messenger Platform) ────────────────────────────
# BLOCKED PENDING APP REVIEW: the code for this is complete and ready, but
# nothing will actually send/receive until a Meta Developer App exists with
# Messenger/Instagram messaging permissions requested AND approved by Meta's
# App Review — this is entirely external and can take days to weeks.
#
# SETUP (once you're ready to start that process):
#   1. Go to https://developers.facebook.com → My Apps → Create App
#   2. App type: Business  →  Add products: Messenger, Instagram
#   3. Messenger → Settings → connect your Facebook Page, generate a Page
#        Access Token → FB_PAGE_ACCESS_TOKEN, copy the Page ID → FB_PAGE_ID
#   4. Instagram → Settings → connect your linked Instagram Business account,
#        copy its ID → FB_IG_BUSINESS_ACCOUNT_ID
#   5. Webhooks → set the Callback URL to https://<your-host>/api/meta/webhook,
#        Verify Token must match FB_WEBHOOK_VERIFY_TOKEN below, subscribe to
#        the "messages", "feed", and "comments" fields
#   6. App Settings → Basic → copy "App Secret" → FB_APP_SECRET
#   7. Request permissions (App Review): pages_messaging, instagram_manage_messages,
#        pages_manage_metadata — Meta reviews these before they work in production
#
# Credentials can also be managed per-Page from Settings inside the app
# (Facebook & Instagram → Settings → Saved Pages) once at least one is saved —
# these two env vars are only the fallback/default.
# FB_PAGE_ACCESS_TOKEN=
# FB_PAGE_ID=
# FB_IG_BUSINESS_ACCOUNT_ID=
#
# App-level secrets (NOT per-Page — set once here, not editable in the UI):
# FB_WEBHOOK_VERIFY_TOKEN=srivani-fb-verify-2026
# FB_APP_SECRET=

# ── Google Contacts (two-way sync, opt-in per contact) ────────────────────────
# BLOCKED ON GOOGLE CLOUD CONSOLE SETUP: the code is complete and ready, but
# nothing connects until a Google Cloud project exists with the OAuth consent
# screen configured. Unlike Meta's App Review, this is usually same-day work —
# Google's restricted-scope security assessment is only required to move the
# consent screen from "Testing" to "In production" publishing status. For a
# single-business internal tool, staying in Testing mode (up to 100 test
# users, full `contacts` scope access, no assessment) is a realistic
# permanent choice.
#
# SETUP:
#   1. Go to https://console.cloud.google.com → create/select a project
#   2. APIs & Services → Library → enable "People API"
#   3. APIs & Services → OAuth consent screen → External → add the
#        `.../auth/contacts` scope → add the store owner's Google account
#        as a Test User → leave publishing status as "Testing"
#   4. APIs & Services → Credentials → Create OAuth client ID → Web application
#        → Authorized redirect URI: https://<your-host>/api/google-contacts/oauth/callback
#      → copy Client ID/Secret below
#
# GOOGLE_CONTACTS_CLIENT_ID=
# GOOGLE_CONTACTS_CLIENT_SECRET=
# GOOGLE_CONTACTS_REDIRECT_URI=https://<your-host>/api/google-contacts/oauth/callback
#
# Sync also needs Redis (REDIS_URL, near the top of this file) for its
# scheduled BullMQ job — without it, the manual "Sync Now" button still
# works, but the every-6h background sync silently never runs.

# ── Web Push (browser/PWA notifications for new WhatsApp messages) ──────────
# Generate once with: npx web-push generate-vapid-keys
# Regenerating invalidates every existing PushSubscription row.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
